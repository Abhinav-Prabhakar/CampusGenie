# Campus Genie LLM & Databricks Environment Configuration

# Primary LLM API Key (used by default across providers)
LLM_API_KEY=

# API Base URL (e.g., https://api.openai.com/v1, https://generativelanguage.googleapis.com/v1beta/openai, or Databricks serving endpoint)
LLM_BASE_URL=https://api.openai.com/v1

# Default Model Name (e.g., gpt-4o, gemini-2.0-flash, dbrx-instruct, claude-3-5-sonnet-20241022)
LLM_MODEL=gpt-4o

# Local development only. Production always rejects caller-supplied endpoints.
ALLOW_CUSTOM_LLM_ENDPOINTS=false

# Provider-Specific Fallbacks (optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Databricks Lakehouse & Unity Catalog (optional)
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_TOKEN=<server-side-token>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
DATABRICKS_GENIE_SPACE_ID=<genie-space-id>
