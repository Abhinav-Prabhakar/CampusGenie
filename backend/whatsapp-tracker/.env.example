# --- LLM (VoidAI / Gemini proxy) ---
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.voidai.app/v1
LLM_MODEL=gemini-3.6-flash

# --- Databricks Lakehouse ---
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
# Leave DATABRICKS_TOKEN empty to fall back to `databricks auth token` (CLI OAuth)
DATABRICKS_WAREHOUSE_ID=your_warehouse_id_here

# --- WhatsApp Web browser tuning (optional) ---
# Explicit proxy for the WhatsApp Web browser; leave empty to bypass the OS
# proxy entirely (local proxies break WhatsApp's WebSocket/QR flow).
WA_PROXY_SERVER=
# Override the browser user agent presented to WhatsApp Web
WA_USER_AGENT=
# Path to a Chrome/Chromium binary, as a fallback when the Puppeteer-managed
# browser cache is corrupt (e.g. "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
PUPPETEER_EXECUTABLE_PATH=
